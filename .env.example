# ==============================================================
# Environment Configuration Template for Burhanuddin Malik Portfolio
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL CREDENTIALS OR .env TO VERSION CONTROL.
# ==============================================================

# Server Port (Default: 8080)
PORT=8080

# Owner Admin Password (Used on initial run or to reset owner password)
OWNER_PASSWORD=your_secure_admin_password_here

# Secret Key for Flask Session Cookies & CSRF Protection (Generate a random 32+ char string)
SECRET_KEY=generate_a_random_32_character_hex_secret_here

# Cookie Security (Set to 1 in production with HTTPS / SSL enabled)
HTTPS=0

# Storage Directory for SQLite Database & Uploads (Default: ./data)
DATA_DIR=data

# Supabase Cloud Database Configuration (PostgreSQL)
# Serverless platforms like Vercel MUST use the Supavisor Transaction Pooler on port 6543.
# Direct/session mode on port 5432 will exhaust connection limits in serverless functions.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_secret_your_supabase_secret_key_here

# Domain & CORS Configuration (For *.vercel.app or custom domains)
SITE_DOMAIN=your-portfolio.vercel.app
ALLOWED_ORIGIN=https://your-portfolio.vercel.app

# Optional: Custom session cookie domain (e.g. .yourdomain.com for subdomains)
# SESSION_COOKIE_DOMAIN=.yourdomain.com

# Optional: Disable background backup scheduler (Default: 0 / enabled; automatically disabled on Vercel)
NO_SCHEDULER=0

# Optional: Remote Cloud Backups (AWS S3, Cloudflare R2, Backblaze B2)
# BACKUP_S3_BUCKET=your-backup-bucket
# BACKUP_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key



